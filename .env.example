# Configuration du mode Docker (Mode 2) — copier vers .env avant `docker compose up -d --build`
MARANYSE_LAN_IP=192.168.1.50
MARANYSE_LAN_SUBNET=192.168.1.0/24
MARANYSE_LAN_GW=192.168.1.1
MARANYSE_LAN_IFACE=eth0
# ipvlan L2 fonctionne sur Ethernet, Wi-Fi et VM
MARANYSE_NET_DRIVER=ipvlan

MARANYSE_PORT=8080
MARANYSE_USERS="driss paul carole"
MARANYSE_LOGIN=parent
MARANYSE_PASSWORD=ChangeMe2026!
